# Copy to `.env` and fill in. `.env` is gitignored.
# Loaded automatically when the daily_report package is imported.

# ---- AI summary (sources/ai_summary.py) ----
# Anthropic API key. Without this the AI summary section prints a
# "(disabled)" placeholder line and the rest of the report still works.
ANTHROPIC_API_KEY=

# ---- Tallied (sources/tallied.py) ----
# Bearer-style API key from money.markcheli.com. Without it the tallied
# section returns sample data marked "_stub: True".
TALLIED_API_KEY=
# Optional override (default: https://money.markcheli.com)
# TALLIED_API_URL=https://money.markcheli.com

# ---- Tasks (sources/tasks.py) ----
# Per-user API key minted in the tasks app's /settings page. Format is
# tsk_<urlsafe-32>. Sent as the X-API-Key header.
TASKS_API_KEY=
# Optional override (default: https://tasks.markcheli.com)
# TASKS_API_URL=https://tasks.markcheli.com

# ---- Weather (sources/weather.py) ----
# Optional: set explicit lat/lon to skip Open-Meteo's geocoder entirely.
# Useful as a hedge against geocoder flakes (we already cache + retry
# but a static override is fastest and most reliable).
# WEATHER_LAT=42.2611
# WEATHER_LON=-71.4636

# ---- Calendar (sources/calendar.py) ----
# Google Calendar's "Secret address in iCal format" URL. Get it from
# Google Calendar -> Settings -> select your calendar -> Integrate
# calendar -> "Secret address in iCal format". This URL is the auth -
# treat it as secret. No OAuth required, works on a headless server.
#
# Accepts a comma-separated list to merge multiple calendars (personal +
# shared birthdays + US holidays, etc.). Events are merged and sorted
# chronologically across all feeds.
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/<personal>/private-<token>/basic.ics,https://calendar.google.com/calendar/ical/<birthdays>/public/basic.ics,https://calendar.google.com/calendar/ical/en.usa%23holiday%40group.v.calendar.google.com/public/basic.ics

# ---- Server (sources/server.py) ----
# Prometheus base URL. Default when running on the homelab in a container
# alongside the monitoring stack: http://prometheus:9090 (docker DNS).
# For other deployments, set explicitly.
# PROM_URL=http://prometheus:9090
# Optional Authorization header value if you go through nginx basic-auth:
# PROM_AUTH=Basic <base64(user:pass)>

# ---- Service / API (daily_report/service.py) ----
# When daily-report runs as a long-lived service, these control the
# schedule loop and HTTP API. See DEPLOYMENT.md.
# Time(s) of day to print, comma-separated HH:MM (24h, container TZ).
REPORT_TIMES=07:00
# Port for the HTTP API.
DAILY_REPORT_PORT=8080
# Optional bearer token; if set, POST /trigger requires
# `Authorization: Bearer <token>`. Leave blank to disable auth.
DAILY_REPORT_API_TOKEN=

# ---- Power (sources/power.py) ----
# Home Assistant long-lived access token. Generate one in HA at:
# Profile -> Long-lived access tokens -> Create token.
HOME_ASSISTANT_TOKEN=
# Optional override (default https://home.markcheli.com)
# HOME_ASSISTANT_URL=https://home.markcheli.com

# ---- Homelab catalog ----
# Override the path to services.json. Default is
# ~/repos/PersonalWebsite/services.json.
# HOMELAB_CATALOG=/path/to/services.json
