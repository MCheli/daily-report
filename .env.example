# Copy to `.env` and fill in. `.env` is gitignored.
# Loaded automatically when the daily_report package is imported.

# ---- AI summary (sources/ai_summary.py) ----
# Anthropic API key. Without this the AI summary section prints a
# "(disabled)" placeholder line and the rest of the report still works.
ANTHROPIC_API_KEY=

# ---- Tallied (sources/tallied.py) ----
# Bearer-style API key from money.markcheli.com. Without it the tallied
# section returns sample data marked "_stub: True".
TALLIED_API_KEY=
# Optional override (default: https://money.markcheli.com)
# TALLIED_API_URL=https://money.markcheli.com

# ---- Tasks (sources/tasks.py)  -- not yet implemented ----
# TASKS_API_URL=https://tasks.markcheli.com
# TASKS_API_KEY=

# ---- Server (sources/server.py) -- not yet implemented ----
# PROM_URL=http://prometheus.ops.markcheli.com:9090

# ---- Homelab catalog ----
# Override the path to services.json. Default is
# ~/repos/PersonalWebsite/services.json.
# HOMELAB_CATALOG=/path/to/services.json
